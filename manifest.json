{
  "manifest_version": 3,
  "name": "B站视频画面深色滤镜",
  "version": "1.5",
  "description": "B站视频反色深色滤镜（适合白底课件）+ 视频倍速控制（带倍速悬浮提示）；快捷键 Alt+D 切换滤镜，- = \\ 与按住 → 控制倍速。",
  "author": "Dua",
  "homepage_url": "https://duasweb.xyz",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "https://onlineplayer.app/zh*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站视频深色滤镜",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
